# RocketReach API Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Your RocketReach API Key (required)
ROCKETREACH_API_KEY=your_api_key_here

# Optional: Email Configuration for sending
SENDER_EMAIL=your_email@example.com
SENDER_PASSWORD=your_password_or_app_specific_password

# Optional: Database connection (if using database storage)
# DATABASE_URL=postgresql://user:pass@localhost/dbname
